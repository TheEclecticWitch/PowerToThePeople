<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package's description. tools/msix/build_msix.py fills in VERSION from desktopApp/build.gradle.kts.
     Identity and publisher come from Partner Center (Product management > Product identity), reserved 18 Oct 2026. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity Name="TheEclecticWitch.P2PPowertothePeople" Publisher="CN=2C7F1318-FAB2-4A00-A2E5-3B6C2AC2BFC9"
            Version="VERSION" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>P2P: Power to the People</DisplayName>
    <PublisherDisplayName>The Eclectic Witch</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="PowerToThePeople" Executable="Power to the People.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="P2P: Power to the People" Description="Your government's public records in plain words: officials, votes, bills and the Constitution."
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
